EXPRESS_DERM_DATA_DIR=./data
EXPRESS_DERM_MAX_UPLOAD_MB=25
EXPRESS_DERM_FOCUS_THRESHOLD=80
EXPRESS_DERM_MIN_BRIGHTNESS=45
EXPRESS_DERM_MAX_BRIGHTNESS=220
EXPRESS_DERM_CAMERA_MOCK=false

# One-command scan profile using the self-contained dual ONNX package.
EXPRESS_DERM_AI_ENABLED=true
EXPRESS_DERM_AI_BACKEND=onnxruntime
EXPRESS_DERM_AI_MODEL_DIR=models/express-derm-1
EXPRESS_DERM_AI_ALLOW_UNVALIDATED_MODEL=true
EXPRESS_DERM_AI_REQUIRED=true
